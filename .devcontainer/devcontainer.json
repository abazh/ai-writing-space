{
  "name": "AI Writing Space",
  "image": "mcr.microsoft.com/devcontainers/python:3.13-bookworm",
  "runArgs": ["--init", "--network=host"],
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4.1.3": {
      "version": "29.9.0"
    },
    "ghcr.io/devcontainers/features/node:2.1.1": {
      "version": "24"
    }
  },
  "mounts": [
    "source=ai-writing-space-home,target=/home/vscode,type=volume"
  ],
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postAttachCommand": "bash .devcontainer/install-quarto.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "openai.chatgpt",
        "Anthropic.claude-code",
        "Google.google-antigravity",
        "quarto.quarto",
        "James-Yu.LaTeX-Workshop",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "ms-toolsai.jupyter"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "quarto.path": "/opt/quarto/bin/quarto",
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit",
          "source.organizeImports": "explicit"
        },
        "files.trimTrailingWhitespace": true,
        "typescript.updateImportsOnFileMove.enabled": "always"
      }
    }
  },
  "remoteEnv": {
    "PATH": "/opt/quarto/bin:/home/vscode/.local/tinytex-bin:/home/vscode/.local/bin:${containerEnv:PATH}"
  },
  "containerEnv": {
    "DISABLE_TELEMETRY": "1"
  }
}
